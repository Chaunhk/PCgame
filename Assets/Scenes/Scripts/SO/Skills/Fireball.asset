%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e499bc8f12a12ff43957cff71f480f27, type: 3}
  m_Name: Fireball
  m_EditorClassIdentifier: 
  skillId: fireball
  displayName: Fireball
  description: Throws a fireball toward the cursor. It deals no impact damage; the
    burning ground it leaves is the damage.
  icon: {fileID: 0}
  role: 0
  activation: 0
  cooldown: 2
  maxCharges: 1
  manaCostOnActivate: 0
  manaCostPerTick: 0
  tickInterval: 0.25
  behaviourPrefab: {fileID: 1071363993428634909, guid: b22f50879618ed64099e864f7ddfbf9e, type: 3}
  parameters:
  - id: projectileCount
    label: Fireballs per shot
    tooltip: How many fireballs leave the muzzle at once. Spread splits evenly around
      the aim direction.
    type: 1
    defaultValue: 1
    min: 1
    max: 12
  - id: spreadAngle
    label: Spread angle
    tooltip: Degrees between neighbouring fireballs. Ignored when only one is fired.
    type: 0
    defaultValue: 15
    min: 0
    max: 60
  - id: zoneDamagePerTick
    label: Burn damage per tick
    tooltip: Damage the burning ground deals each tick. This is the number every
      other skill inherits a share of.
    type: 1
    defaultValue: 3
    min: 0
    max: 100
  - id: zoneRadius
    label: Burn radius
    tooltip: Size of the burning ground, before the global area modifier.
    type: 0
    defaultValue: 2
    min: 0.5
    max: 10
  - id: zoneTickInterval
    label: Burn tick interval
    tooltip: Seconds between burn ticks. Lower means more ticks, so more total damage.
    type: 3
    defaultValue: 0.5
    min: 0.1
    max: 2
  objectParameters: []
  scalesWithSpDamage: 1
  scalesWithSpArea: 1
  scalesWithSpCost: 1
