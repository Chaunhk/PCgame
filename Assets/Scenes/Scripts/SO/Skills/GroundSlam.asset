--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e499bc8f12a12ff43957cff71f480f27, type: 3}
  m_Name: GroundSlam
  m_EditorClassIdentifier: 
  skillId: ground_slam
  displayName: Ground Slam
  description: Slams the ground for an instant blast, then leaves burning ground.
  icon: {fileID: 0}
  role: 1
  activation: 0
  cooldown: 6
  maxCharges: 1
  manaCostOnActivate: 15
  manaCostPerTick: 0
  tickInterval: 0.25
  behaviourPrefab: {fileID: 7981759748477900576, guid: db86915fca1970b43b43670ba7a88ab0, type: 3}
  parameters:
  - id: blastDamage
    label: Blast damage
    tooltip: One-off damage dealt the moment the slam lands.
    type: 1
    defaultValue: 25
    min: 0
    max: 500
  - id: blastRadius
    label: Blast radius
    tooltip: How far the initial blast reaches, before the global area modifier.
    type: 0
    defaultValue: 3
    min: 0.5
    max: 15
  - id: zoneDamagePerTick
    label: Burn damage per tick (own)
    tooltip: The zone's own base damage, before inheriting from the basic attack.
    type: 1
    defaultValue: 2
    min: 0
    max: 100
  - id: zoneRadius
    label: Burn radius (own)
    tooltip: The zone's own base size, before inheriting from the basic attack.
    type: 0
    defaultValue: 1.5
    min: 0.5
    max: 10
  - id: zoneInherit
    label: Inherit from basic attack
    tooltip: Share of the basic attack's burn added on top. 0.4 = the kit's 30~50%.
    type: 2
    defaultValue: 0.4
    min: 0
    max: 1
  - id: zoneTickInterval
    label: Burn tick interval
    tooltip: Seconds between burn ticks. 0 means copy the basic attack's interval.
    type: 3
    defaultValue: 0
    min: 0
    max: 2
  scalesWithSpDamage: 1
  scalesWithSpArea: 1
  scalesWithSpCost: 1
